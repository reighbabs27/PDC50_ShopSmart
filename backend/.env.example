DATABASE_URL="postgresql://shopsmart_user:shopsmart_dev@localhost:5432/shopsmart?schema=public"
PORT=3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Grounded Product Assistant provider: mock | none | gemini
#   mock   = labeled simulated provider, no network call, no cost
#   none   = catalog rules only
#   gemini = live provider, needs GEMINI_API_KEY (server-only secret)
AI_PROVIDER=mock
# MOCK_PROVIDER_BEHAVIOR=ok   # ok | timeout | rate_limit | malformed | hallucinate | wrong_price
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
AI_TIMEOUT_MS=8000

# Production settings live in /etc/shopsmart/api.env on the server (see deploy/api.env.example):
# HOST=127.0.0.1
# TRUST_PROXY=true
# REQUIRE_HTTPS=true
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax
