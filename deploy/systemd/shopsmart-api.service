# Keeps the Express API running and starts it again after a crash or an instance reboot.
# Logs go to journald:  sudo journalctl -u shopsmart-api -f
[Unit]
Description=ShopSmart Express API
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=shopsmart
Group=shopsmart
WorkingDirectory=/opt/shopsmart/backend
# Server-only settings (DATABASE_URL, provider key). Mode 640, owner root:shopsmart.
EnvironmentFile=/etc/shopsmart/api.env
# Written by deploy-release.sh: APP_VERSION and GIT_COMMIT of the running release.
EnvironmentFile=-/etc/shopsmart/release.env
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

# Basic hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
