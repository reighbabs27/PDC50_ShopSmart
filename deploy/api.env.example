# /etc/shopsmart/api.env on the EC2 host. NEVER commit the real file or screenshot it.
# setup-ec2.sh creates it with a generated database password (mode 640, root:shopsmart).
NODE_ENV=production
PORT=3000
# Bind to localhost so only nginx can reach Express.
HOST=127.0.0.1

# Server-only secret. Not a VITE_ variable, never sent to the browser.
DATABASE_URL="postgresql://shopsmart_app:<generated-password>@127.0.0.1:5432/shopsmart?schema=public"

# Exact public origin of the frontend (comma-separate several origins if needed).
FRONTEND_URL=https://<your-domain>

# nginx terminates HTTPS and forwards X-Forwarded-Proto.
TRUST_PROXY=true
REQUIRE_HTTPS=true
COOKIE_SECURE=true
# lax for the single-host layout. Use "none" only for Amplify + separate API domain.
COOKIE_SAMESITE=lax

# Assistant provider: mock (labeled simulation, no cost), none (catalog rules only),
# or gemini (needs GEMINI_API_KEY; instructor approval required for a paid key).
AI_PROVIDER=mock
# MOCK_PROVIDER_BEHAVIOR=ok   # ok | timeout | rate_limit | malformed | hallucinate | wrong_price
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
AI_TIMEOUT_MS=8000
